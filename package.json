{
  "name": "gamingx-overlay",
  "productName": "GamingX Overlay",
  "version": "1.0.0",
  "description": "Gaming оверлей поверх всех приложений: FPS, системная информация, оптимизация Windows, меню по Ctrl+Alt+X",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --win",
    "dist": "electron-builder --win"
  },
  "keywords": ["gaming", "overlay", "fps", "electron", "system-info", "windows-optimizer"],
  "author": "GamingOverlay",
  "license": "MIT",
  "dependencies": {
    "systeminformation": "^5.23.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.gamingx.overlay",
    "productName": "GamingX Overlay",
    "copyright": "Copyright © 2026 GamingX",
    "directories": {
      "output": "release"
    },
    "files": ["**/*", "!node_modules/**/*.md", "!**/.gitignore", "!release/"],
    "win": {
      "target": "nsis",
      "arch": ["x64"],
      "publisherName": "GamingX"
    }
  }
}
